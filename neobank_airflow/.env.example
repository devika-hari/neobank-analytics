# Copy to .env and fill in real values. .env is gitignored -- never commit it.
# These back the `dev` and `prod` targets in profiles.yml (dbt build/run --target ...).

# Shared across dev and prod: one Snowflake account/role/warehouse, split by database.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=transformer
SNOWFLAKE_WAREHOUSE=neobank_wh

# dev target
SNOWFLAKE_DATABASE=neobank
SNOWFLAKE_SCHEMA=dbt_schema

# prod target -- must point at a different database than dev. No default/fallback
# is defined in profiles.yml on purpose: if these are unset, a --target prod run
# fails loudly instead of silently writing into the dev database.
SNOWFLAKE_PROD_DATABASE=
SNOWFLAKE_PROD_SCHEMA=
